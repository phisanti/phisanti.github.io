---
import Base from './Base.astro';
import StrataBackdrop from '../components/StrataBackdrop.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, heading = title, description } = Astro.props;
---

<Base title={`${title} · Santiago Cano-Muniz`} description={description}>
  <StrataBackdrop />
  <div class="page">
    <h1>{heading}</h1>
    <slot />
  </div>
</Base>

<style>
  .page { width: min(44rem, calc(100% - 40px)); margin: 0 auto; padding: 64px 0 48px; }
  h1 { margin: 0 0 28px; font-size: 3rem; line-height: 1.1; }
  .page :global(h2) { margin: 36px 0 12px; font-size: 1.75rem; line-height: 1.2; }
  @media (max-width: 767.98px) {
    .page { padding-top: 36px; }
    h1 { font-size: 2.25rem; }
  }
</style>
