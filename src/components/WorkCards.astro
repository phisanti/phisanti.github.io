---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul>
  {projects.map((project) => (
    <li>
      <a class="card" href={project.data.repo ?? '/projects/'}>
        <span class="k">{project.data.kind} · {project.data.year}</span>
        <h3>{project.data.title}</h3>
        <p>{project.data.summary}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  li { display: flex; }
  .card, .card:visited { color: inherit; background: var(--panel); }
  .card {
    flex: 1;
    display: block;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: transform var(--dur-card) var(--ease-out), border-color var(--dur-card) ease;
  }
  .card:hover, .card:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
  }
  h3 { margin: 6px 0; font-size: 1.4375rem; }
  p { margin: 0; font-size: 1.03125rem; line-height: 1.48; }

  @media (max-width: 767.98px) {
    ul { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
