---
import { social, emailMask } from '../data/social';

interface Props {
  /** Title of the essay the card closes; becomes the email subject. */
  title: string;
}

const { title } = Astro.props;
const link = (id: string) => social.find((s) => s.id === id)!.url;
---

<aside class="author" aria-label="About the author">
  <img class="portrait" src="/profile.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
  <div>
    <h2>Santiago Cano-Muniz</h2>
    <p>
      I build statistics-first AI tooling for omics analysis at BigOmics. If this essay touched a problem you have,
      write to me.
    </p>
    <div class="actions">
      <a class="btn" href="/contact/" data-mask={emailMask} data-subject={`Re: ${title}`}>Email me</a>
      <a class="btn ghost" href={link('linkedin')}>LinkedIn</a>
      <a class="btn ghost" href={link('rss')}>RSS</a>
    </div>
  </div>
</aside>

<style>
  .author {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 18px;
    margin: 44px 0 28px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--panel);
  }
  .portrait {
    width: 72px;
    height: 72px;
  }
  h2 { margin: 0 0 4px; font-size: 1.375rem; }
  p { margin: 0 0 12px; font-size: 1.0625rem; line-height: 1.48; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn { padding: 8px 14px; font-size: 1rem; }
  @media (max-width: 767.98px) {
    .author { grid-template-columns: 1fr; padding: 20px; }
  }
</style>
