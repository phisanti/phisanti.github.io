---
/** Strata canvas for the home hero layer; it reacts to the pointer over the enclosing `.hero`. */
---

<canvas class="strata" aria-hidden="true"></canvas>

<script>
  import { initStrata } from '../scripts/strata';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.strata');
  if (canvas) initStrata(canvas, canvas.closest<HTMLElement>('.hero') ?? canvas);
</script>

<style>
  .strata {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Fades the field to about 12% under the headline. */
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, .12) 8%, rgba(0, 0, 0, .35) 40%, #000 70%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, .12) 8%, rgba(0, 0, 0, .35) 40%, #000 70%);
  }
  /* Phone: the text spans the full width, so keep lines faint until below the buttons. */
  @media (max-width: 767.98px) {
    .strata {
      -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, .1) 0%, rgba(0, 0, 0, .1) 70%, rgba(0, 0, 0, .6) 100%);
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, .1) 0%, rgba(0, 0, 0, .1) 70%, rgba(0, 0, 0, .6) 100%);
    }
  }
</style>
