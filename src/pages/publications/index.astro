---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { social } from '../../data/social';

const papers = (await getCollection('papers')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const scholar = social.find((s) => s.id === 'scholar')!.url;
---

<Page title="Publications" description="Peer-reviewed papers.">
  <ul>
    {papers.map(({ id, data }) => (
      <li id={id}>
        <p class="k">{data.venue} · {data.date.getUTCFullYear()}</p>
        <a class="title" href={data.url}>{data.title}</a>
        <p class="cite">{data.citation}</p>
      </li>
    ))}
  </ul>
  <p><a href={scholar}>All on Google Scholar →</a></p>
</Page>

<style>
  ul { margin: 0 0 24px; padding: 0; list-style: none; }
  li { padding: 16px 0; border-bottom: 1px solid var(--border); scroll-margin-top: 24px; }
  li p { margin: 0; }
  .title { font-size: 1.375rem; line-height: 1.3; }
  .cite { margin-top: 4px; color: var(--fg-light); font-size: 1rem; }
</style>
